---
/**
 * Decorative product-style visual: a live request tracing through a
 * service map, mirrored by a span waterfall. Pure CSS/SVG animation.
 */
const nodes = [
  { id: "web", name: "web", meta: "Next.js", x: 11, y: 50, hot: 0 },
  { id: "api", name: "api-gateway", meta: "NestJS", x: 36, y: 50, hot: 1 },
  { id: "queue", name: "queue", meta: "service", x: 62, y: 20, hot: 2 },
  { id: "search", name: "search", meta: "service", x: 62, y: 50 },
  { id: "geo", name: "geo", meta: "service", x: 62, y: 80 },
  { id: "redis", name: "redis", meta: "cache", x: 89, y: 20, hot: 3 },
  { id: "pg", name: "postgres", meta: "PostGIS", x: 89, y: 62, hot: 4 },
];

// Coordinates in a 1000×500 space; nodes use the same percentages.
const edges = [
  { d: "M110 250 H360", hot: 0 },
  { d: "M360 250 C490 250 490 100 620 100", hot: 1 },
  { d: "M360 250 H620", idle: 0 },
  { d: "M360 250 C490 250 490 400 620 400", idle: 1 },
  { d: "M620 100 H890", hot: 2 },
  { d: "M620 100 C755 100 755 310 890 310", hot: 3 },
  { d: "M620 250 C755 250 755 310 890 310", idle: 2 },
  { d: "M620 400 C755 400 755 310 890 310" },
];

const spans = [
  { name: "http.request", start: 0, width: 100, depth: 0, ms: "38ms" },
  { name: "auth.verify", start: 2, width: 9, depth: 1, ms: "3ms" },
  { name: "queue.load", start: 13, width: 48, depth: 1, ms: "18ms" },
  { name: "redis.get", start: 15, width: 8, depth: 2, ms: "3ms" },
  { name: "pg.select", start: 26, width: 32, depth: 2, ms: "12ms" },
  { name: "wait.estimate", start: 63, width: 22, depth: 1, ms: "8ms" },
  { name: "serialize", start: 87, width: 10, depth: 1, ms: "4ms" },
];
---

<div class="visual" role="img" aria-label="Illustration of a request tracing through a service map: web client, API gateway, queue, search and geo services, PostgreSQL and Redis." data-live>
  <div class="panel">
    <div class="panel-bar" aria-hidden="true">
      <div class="tabs">
        <span class="tab is-active">System map</span>
        <span class="tab">Traces</span>
        <span class="tab tab-hide">Logs</span>
      </div>
      <span class="live"><span class="live-dot"></span>live</span>
    </div>

    <div class="panel-body" aria-hidden="true">
      <div class="map">
        <svg class="edges" viewBox="0 0 1000 500" preserveAspectRatio="none">
          {edges.map((e) => <path class="edge" d={e.d} vector-effect="non-scaling-stroke" />)}
          {
            edges
              .filter((e) => e.hot !== undefined)
              .map((e) => (
                <path class="packet" d={e.d} pathLength="100" style={`--n:${e.hot}`} />
              ))
          }
          {
            edges
              .filter((e) => e.idle !== undefined)
              .map((e) => (
                <path class="packet packet-idle" d={e.d} pathLength="100" style={`--n:${e.idle}`} />
              ))
          }
        </svg>
        {
          nodes.map((n) => (
            <div class:list={["node", { "is-hot": n.hot !== undefined }]} style={`--x:${n.x}%;--y:${n.y}%;--n:${n.hot ?? 0}`}>
              <span class="node-dot" />
              <span class="node-name">{n.name}</span>
              <span class="node-meta">{n.meta}</span>
            </div>
          ))
        }
      </div>

      <div class="trace">
        <div class="trace-head">
          <span class="method">GET</span>
          <span class="route">/v1/clinics/:id/queue</span>
          <span class="status">200</span>
        </div>
        <ol class="spans">
          {
            spans.map((s, i) => (
              <li style={`--d:${s.depth};--s:${s.start}%;--w:${s.width}%;--i:${i}`} class={`depth-${s.depth}`}>
                <span class="span-name">{s.name}</span>
                <span class="span-track">
                  <span class="span-bar" />
                </span>
                <span class="span-ms">{s.ms}</span>
              </li>
            ))
          }
          <span class="playhead" />
        </ol>
        <ul class="events">
          <li><span class="ev-dot ok"></span>patient.checked_in<span class="ev-meta">A-014</span></li>
          <li><span class="ev-dot"></span>queue.recalculated<span class="ev-meta">eta updated</span></li>
          <li><span class="ev-dot info"></span>schedule.synced<span class="ev-meta">dr-garcia</span></li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .visual {
    --loop: 4.8s;
    position: relative;
    perspective: 1600px;
  }

  .panel {
    position: relative;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-lg);
    background:
      linear-gradient(to bottom, color-mix(in oklch, var(--bg-elevated) 92%, transparent), var(--bg-elevated));
    box-shadow: var(--shadow-2);
    overflow: hidden;
    transform-origin: 50% 0;
  }

  /* Hairline highlight along the top edge */
  .panel::before {
    content: "";
    position: absolute;
    inset: 0 0 auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, color-mix(in oklch, var(--accent) 60%, transparent), transparent);
    opacity: 0.7;
  }

  .panel-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-3);
  }

  .tabs {
    display: flex;
    gap: 4px;
  }

  .tab {
    padding: 3px 10px;
    border-radius: 6px;
  }

  .tab.is-active {
    color: var(--text);
    background: var(--surface-2);
  }

  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: 10.5px;
  }

  .live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
    box-shadow: 0 0 0 0 color-mix(in oklch, var(--ok) 50%, transparent);
    animation: ping 2.4s var(--ease-out) infinite;
  }

  @keyframes ping {
    0% {
      box-shadow: 0 0 0 0 color-mix(in oklch, var(--ok) 55%, transparent);
    }
    70%,
    100% {
      box-shadow: 0 0 0 7px transparent;
    }
  }

  .panel-body {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
  }

  /* --- Service map --- */

  .map {
    position: relative;
    aspect-ratio: 2 / 1.12;
    margin: 12px;
    border-radius: var(--radius-md);
    background-image: radial-gradient(circle at 1px 1px, var(--grid-line) 1px, transparent 0);
    background-size: 18px 18px;
  }

  .edges {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .edge {
    fill: none;
    stroke: var(--border-strong);
    stroke-width: 1.25;
  }

  .packet {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2.75;
    stroke-linecap: round;
    stroke-dasharray: 14 86;
    stroke-dashoffset: 14;
    opacity: 0;
    animation: packet var(--loop) var(--ease-in-out) infinite;
    animation-delay: calc(var(--n) * 600ms);
  }

  .packet-idle {
    stroke: var(--text-3);
    stroke-width: 1.5;
    stroke-dasharray: 8 92;
    animation-duration: calc(var(--loop) * 1.5);
    animation-delay: calc(900ms + var(--n) * 1.3s);
  }

  @keyframes packet {
    0% {
      stroke-dashoffset: 14;
      opacity: 1;
    }
    28% {
      stroke-dashoffset: -86;
      opacity: 1;
    }
    30%,
    100% {
      stroke-dashoffset: -86;
      opacity: 0;
    }
  }

  .node {
    position: absolute;
    left: var(--x);
    top: var(--y);
    translate: -50% -50%;
    display: grid;
    grid-template-columns: auto auto;
    align-items: center;
    column-gap: 6px;
    padding: 6px 10px 6px 8px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-elevated);
    box-shadow: var(--shadow-1);
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .node-dot {
    grid-row: span 2;
    width: 6px;
    height: 6px;
    border-radius: 2px;
    background: var(--text-3);
  }

  .node-name {
    font-size: 11.5px;
    color: var(--text);
    line-height: 1.3;
  }

  .node-meta {
    grid-column: 2;
    font-size: 10px;
    color: var(--text-3);
    line-height: 1.3;
  }

  .node.is-hot {
    animation: node-hot var(--loop) var(--ease-out) infinite;
    animation-delay: calc(var(--n) * 600ms + 744ms);
  }

  .node.is-hot .node-dot {
    background: var(--accent);
  }

  @keyframes node-hot {
    0% {
      border-color: var(--accent);
      box-shadow: 0 0 0 4px var(--accent-soft), var(--shadow-1);
    }
    22%,
    100% {
      border-color: var(--border-strong);
      box-shadow: 0 0 0 0 transparent, var(--shadow-1);
    }
  }

  /* --- Trace --- */

  .trace {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px 16px 16px;
    border-left: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 11px;
    min-width: 0;
  }

  .trace-head {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--text-2);
  }

  .method {
    padding: 1px 6px;
    border-radius: 4px;
    background: var(--accent-soft);
    color: var(--accent-ink);
    font-weight: 500;
  }

  .route {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .status {
    margin-left: auto;
    color: var(--ok);
  }

  .spans {
    position: relative;
    list-style: none;
    display: grid;
    gap: 10px;
  }

  .spans li {
    display: grid;
    grid-template-columns: minmax(0, 7.2rem) 1fr 2.4rem;
    align-items: center;
    gap: 10px;
    color: var(--text-2);
  }

  .span-name {
    padding-left: calc(var(--d) * 8px);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .depth-0 .span-name {
    color: var(--text);
  }

  .span-track {
    position: relative;
    height: 8px;
  }

  .span-bar {
    position: absolute;
    top: 0;
    bottom: 0;
    left: var(--s);
    width: var(--w);
    border-radius: 3px;
    background: color-mix(in oklch, var(--text-3) 45%, transparent);
    transform-origin: left;
    animation: grow 700ms var(--ease-out) both;
    animation-delay: calc(700ms + var(--i) * 90ms);
  }

  .depth-0 .span-bar {
    background: color-mix(in oklch, var(--text) 22%, transparent);
  }

  .depth-2 .span-bar {
    background: var(--accent);
    opacity: 0.85;
  }

  @keyframes grow {
    from {
      transform: scaleX(0);
    }
  }

  .span-ms {
    text-align: right;
    color: var(--text-3);
  }

  /* Playhead sweeps the span track region in sync with the packets */
  .playhead {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: calc(7.2rem + 10px);
    right: calc(2.4rem + 10px);
    pointer-events: none;
  }

  .playhead::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 100%;
    border-left: 1px solid var(--accent);
    opacity: 0;
    animation: sweep var(--loop) linear infinite;
  }

  @keyframes sweep {
    0% {
      transform: translateX(0);
      opacity: 0.9;
    }
    70% {
      transform: translateX(100%);
      opacity: 0.9;
    }
    72%,
    100% {
      transform: translateX(100%);
      opacity: 0;
    }
  }

  .events {
    list-style: none;
    display: grid;
    gap: 6px;
    margin-top: auto;
    padding-top: 10px;
    border-top: 1px dashed var(--border-strong);
    color: var(--text-2);
  }

  .events li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .events li:nth-child(2) {
    animation: event-in var(--loop) var(--ease-out) infinite;
    animation-delay: 1.5s;
  }

  @keyframes event-in {
    0% {
      opacity: 0;
      transform: translateY(4px);
    }
    8%,
    100% {
      opacity: 1;
      transform: none;
    }
  }

  .ev-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--accent);
  }

  .ev-dot.ok {
    background: var(--ok);
  }

  .ev-dot.info {
    background: var(--info);
  }

  @media (prefers-reduced-motion: reduce) {
    .packet,
    .playhead {
      display: none;
    }
  }

  .ev-meta {
    margin-left: auto;
    color: var(--text-3);
  }

  /* Pause every loop while off-screen */
  .visual:not([data-visible]) :is(.packet, .node, .live-dot, .events li) {
    animation-play-state: paused;
  }

  .visual:not([data-visible]) .playhead::before {
    animation-play-state: paused;
  }

  /* Subtle tilt that settles as the panel scrolls into view */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) and (min-width: 768px) {
      .panel {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 45%;
      }

      @keyframes settle {
        from {
          transform: rotateX(14deg) scale(0.96);
        }
        to {
          transform: none;
        }
      }
    }
  }

  /* --- Responsive --- */

  @media (max-width: 1023px) {
    .panel-body {
      grid-template-columns: 1fr;
    }

    .trace {
      border-left: 0;
      border-top: 1px solid var(--border);
    }
  }

  @media (max-width: 559px) {
    .map {
      aspect-ratio: 1 / 0.82;
      margin: 8px;
    }

    .node {
      padding: 4px 7px 4px 6px;
      column-gap: 5px;
    }

    .node-name {
      font-size: 10px;
    }

    .node-meta,
    .tab-hide {
      display: none;
    }

    .spans li {
      grid-template-columns: minmax(0, 6.2rem) 1fr 2.2rem;
      gap: 8px;
    }

    .playhead {
      left: calc(6.2rem + 8px);
      right: calc(2.2rem + 8px);
    }

    .trace {
      font-size: 10.5px;
      padding: 12px;
    }
  }
</style>
