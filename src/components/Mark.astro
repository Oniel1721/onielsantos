---
interface Props {
  size?: number;
}
const { size = 26 } = Astro.props;
---

<svg class="mark" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true">
  <rect width="32" height="32" rx="8" fill="var(--text)"></rect>
  <circle cx="15" cy="17" r="6.5" fill="none" stroke="var(--bg)" stroke-width="3"></circle>
  <circle cx="23.5" cy="8.5" r="2.75" fill="var(--accent)"></circle>
</svg>
