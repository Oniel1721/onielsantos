---
import { Image } from "astro:assets";
import portrait from "../assets/oniel.png";
import HeroVisual from "./HeroVisual.astro";
import Icon from "./Icon.astro";
import { links } from "../data/site";

const stack = ["TypeScript", "React", "Next.js", "Node.js", "NestJS", "PostgreSQL", "AWS"];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero-bg" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="identity" style="--i:0">
      <Image
        class="avatar"
        src={portrait}
        alt=""
        width={40}
        height={40}
        densities={[1, 2]}
        loading="eager"
        fetchpriority="high"
      />
      <div class="identity-text">
        <span class="identity-name">Oniel Santos</span>
        <span class="identity-role">Senior Full-Stack Engineer</span>
      </div>
      <span class="status"><span class="status-dot" aria-hidden="true"></span>Open to new roles · Remote</span>
    </div>

    <h1 id="hero-title" class="hero-title" style="--i:1">
      I build scalable products, APIs, and web experiences that feel <span class="serif">finished.</span>
    </h1>

    <div class="hero-row">
      <div class="hero-copy">
        <p class="hero-lead" style="--i:2">
          6+ years shipping SaaS end to end — from PostgreSQL schemas and NestJS services to the React interfaces
          people use every day, and lately the AI integrations that automate the work behind them. I own products
          from first sketch to production.
        </p>

        <div class="hero-ctas" style="--i:3">
          <a class="btn btn-primary" href="#work">
            View selected work
            <Icon name="arrow-down" />
          </a>
          <a class="btn btn-secondary" href="#contact">
            Get in touch
            <Icon name="arrow-right" />
          </a>
          <span class="cta-divider" aria-hidden="true"></span>
          <a class="icon-btn" href={links.github} target="_blank" rel="noopener" aria-label="GitHub">
            <Icon name="github" />
          </a>
          <a class="icon-btn" href={links.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn">
            <Icon name="linkedin" />
          </a>
        </div>
      </div>

      <dl class="hero-stack" style="--i:4">
        <dt>Daily stack</dt>
        <dd>
          <ul role="list">
            {stack.map((item) => <li>{item}</li>)}
          </ul>
        </dd>
      </dl>
    </div>

    <div class="hero-visual" style="--i:5">
      <HeroVisual />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--nav-h) + clamp(3rem, 2rem + 5vw, 6.5rem));
    padding-bottom: var(--space-section);
    isolation: isolate;
  }

  /* Grid backdrop fading out from the top, plus one restrained warm glow */
  .hero-bg {
    position: absolute;
    inset: 0 0 auto;
    height: min(1100px, 130%);
    z-index: -1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 60% 40% at 70% 62%, var(--glow), transparent 70%),
      linear-gradient(var(--grid-line) 1px, transparent 1px) 0 0 / 64px 64px,
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px) 0 0 / 64px 64px;
    mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 90% 70% at 50% 0%, #000 30%, transparent 75%);
  }

  .hero-inner {
    display: grid;
  }

  /* Identity */
  .identity {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: clamp(1.75rem, 1rem + 2.5vw, 2.75rem);
  }

  .avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
    object-position: 50% 30%;
    box-shadow: 0 0 0 1px var(--border-strong);
  }

  .identity-text {
    display: grid;
    line-height: 1.3;
  }

  .identity-name {
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.01em;
  }

  .identity-role {
    font-size: var(--step--1);
    color: var(--text-3);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin-left: var(--space-3);
    padding: 5px 12px 5px 10px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in oklch, var(--surface) 70%, transparent);
    font-family: var(--font-mono);
    font-size: var(--step--2);
    color: var(--text-2);
  }

  .status-dot {
    position: relative;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--ok);
  }

  .status-dot::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--ok);
    animation: status-ping 2.4s var(--ease-out) infinite;
  }

  @keyframes status-ping {
    0% {
      transform: scale(1);
      opacity: 0.7;
    }
    70%,
    100% {
      transform: scale(3);
      opacity: 0;
    }
  }

  /* Headline */
  .hero-title {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.045em;
    font-weight: 500;
    max-width: 15.5em;
  }

  .hero-title .serif {
    font-size: 1.08em;
    letter-spacing: -0.02em;
    color: var(--accent-ink);
  }

  /* Lead + CTAs */
  .hero-row {
    display: grid;
    grid-template-columns: minmax(0, 38rem) auto;
    justify-content: space-between;
    align-items: end;
    gap: var(--space-6) var(--space-7);
    margin-top: clamp(1.5rem, 1rem + 2vw, 2.5rem);
  }

  .hero-lead {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--text-2);
    max-width: 36rem;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }

  .cta-divider {
    width: 1px;
    height: 20px;
    margin-inline: var(--space-1);
    background: var(--border-strong);
  }

  .hero-stack {
    display: grid;
    gap: var(--space-3);
    justify-items: end;
    text-align: right;
  }

  .hero-stack dt {
    font-family: var(--font-mono);
    font-size: var(--step--2);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-3);
  }

  .hero-stack ul {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 6px;
    max-width: 17rem;
  }

  .hero-stack li {
    padding: 3px 9px;
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-2);
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .hero-stack li:hover {
    color: var(--text);
    border-color: var(--border-strong);
  }

  .hero-visual {
    margin-top: clamp(3rem, 2rem + 4vw, 5rem);
  }

  /* Staggered entrance — transform-led so text paints immediately */
  @media (prefers-reduced-motion: no-preference) {
    .hero-inner > *,
    .hero-row > *,
    .hero-copy > * {
      animation: hero-in 720ms var(--ease-out) both;
      animation-delay: calc(80ms + var(--i, 0) * 90ms);
    }

    .hero-row,
    .hero-copy {
      animation: none;
    }

    .hero-visual {
      animation-name: hero-visual-in;
      animation-duration: 1000ms;
    }

    @keyframes hero-in {
      from {
        opacity: 0.001;
        transform: translateY(14px);
      }
    }

    @keyframes hero-visual-in {
      from {
        opacity: 0;
        transform: translateY(32px);
      }
    }
  }

  @media (max-width: 899px) {
    .hero-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-stack {
      justify-items: start;
      text-align: left;
    }

    .hero-stack ul {
      justify-content: flex-start;
      max-width: none;
    }
  }

  @media (max-width: 559px) {
    .status {
      margin-left: 0;
    }

    .hero-ctas .btn {
      flex: 1 1 auto;
    }

    .cta-divider {
      display: none;
    }
  }
</style>
