---
import Icon from "./Icon.astro";
import Mark from "./Mark.astro";
import { links, navItems } from "../data/site";
---

<header class="nav" data-nav>
  <div class="nav-inner container">
    <a class="brand" href="#top" aria-label="Oniel Santos — back to top">
      <Mark />
      <span class="brand-name">Oniel Santos</span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      <ul role="list">
        {
          navItems.map((item) => (
            <li>
              <a href={item.href} data-spy={item.href.slice(1)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav-actions">
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
      <a class="btn btn-sm btn-secondary nav-resume" href={links.resume} target="_blank" rel="noopener">
        Résumé
      </a>
      <button
        class="icon-btn menu-btn"
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Open menu"
      >
        <span class="menu-lines" aria-hidden="true"><span></span><span></span></span>
      </button>
    </div>
  </div>

  <div class="mobile-menu" id="mobile-menu">
    <nav class="container" aria-label="Mobile">
      <ul role="list">
        {
          navItems.map((item, i) => (
            <li style={`--i:${i}`}>
              <a href={item.href}>
                {item.label}
                <Icon name="arrow-right" />
              </a>
            </li>
          ))
        }
      </ul>
      <div class="mobile-meta">
        <a href={links.resume} target="_blank" rel="noopener">Résumé</a>
        <a href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={links.linkedin} target="_blank" rel="noopener">LinkedIn</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      backdrop-filter var(--dur-2) var(--ease-out);
  }

  .nav[data-scrolled],
  .nav[data-menu-open] {
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    border-bottom-color: var(--border);
    backdrop-filter: blur(14px) saturate(1.4);
    -webkit-backdrop-filter: blur(14px) saturate(1.4);
  }

  .nav[data-menu-open] {
    background: var(--bg);
    box-shadow: 0 24px 48px -12px oklch(0 0 0 / 0.45);
  }

  .nav-inner {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    font-weight: 500;
    font-size: 0.9375rem;
    letter-spacing: -0.015em;
    border-radius: var(--radius-sm);
  }

  .brand :global(.mark) {
    transition: transform var(--dur-3) var(--ease-spring);
  }

  .brand:hover :global(.mark) {
    transform: rotate(-8deg) scale(1.06);
  }

  .nav-links {
    margin-inline: auto;
  }

  .nav-links ul {
    display: flex;
    gap: var(--space-1);
  }

  .nav-links a {
    position: relative;
    display: block;
    padding: 6px 12px;
    font-size: 0.875rem;
    color: var(--text-2);
    border-radius: 999px;
    transition: color var(--dur-1) var(--ease-out);
  }

  .nav-links a::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--surface-2);
    opacity: 0;
    transform: scale(0.85);
    transition:
      opacity var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
    z-index: -1;
  }

  .nav-links a:hover,
  .nav-links a[aria-current="true"] {
    color: var(--text);
  }

  .nav-links a:hover::before {
    opacity: 1;
    transform: none;
  }

  .nav-links a[aria-current="true"]::after {
    content: "";
    position: absolute;
    left: 50%;
    bottom: -2px;
    width: 4px;
    height: 4px;
    margin-left: -2px;
    border-radius: 50%;
    background: var(--accent);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  /* Theme icon swap */
  .theme-toggle :global(svg) {
    grid-area: 1 / 1;
    transition:
      transform var(--dur-3) var(--ease-spring),
      opacity var(--dur-2) var(--ease-out);
  }

  :global([data-theme="dark"]) .theme-toggle :global(.icon-sun),
  :global([data-theme="light"]) .theme-toggle :global(.icon-moon) {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  /* Menu button */
  .menu-btn {
    display: none;
  }

  .menu-lines {
    display: grid;
    gap: 5px;
    width: 18px;
  }

  .menu-lines span {
    height: 1.5px;
    background: currentColor;
    border-radius: 1px;
    transition: transform var(--dur-2) var(--ease-out);
  }

  [aria-expanded="true"] .menu-lines span:first-child {
    transform: translateY(3.25px) rotate(45deg);
  }

  [aria-expanded="true"] .menu-lines span:last-child {
    transform: translateY(-3.25px) rotate(-45deg);
  }

  /* Mobile menu */
  .mobile-menu {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-3) var(--ease-out);
  }

  .mobile-menu > nav {
    overflow: hidden;
    visibility: hidden;
    transition: visibility 0s var(--dur-3);
  }

  .mobile-menu[data-open] {
    grid-template-rows: 1fr;
  }

  .mobile-menu[data-open] > nav {
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-menu ul {
    padding-top: var(--space-2);
  }

  .mobile-menu li {
    border-bottom: 1px solid var(--border);
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }

  .mobile-menu[data-open] li {
    opacity: 1;
    transform: none;
    transition-delay: calc(60ms + var(--i) * 40ms);
  }

  .mobile-menu li a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-4);
    font-size: 1.375rem;
    letter-spacing: -0.02em;
  }

  .mobile-menu li :global(svg) {
    color: var(--text-3);
  }

  .mobile-meta {
    display: flex;
    gap: var(--space-5);
    padding-block: var(--space-5) var(--space-6);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--text-2);
  }

  @media (max-width: 767px) {
    .nav-links,
    .nav-resume {
      display: none;
    }

    .nav-actions {
      margin-left: auto;
    }

    .menu-btn {
      display: inline-grid;
    }
  }

  @media (min-width: 768px) {
    .mobile-menu {
      display: none;
    }
  }
</style>
