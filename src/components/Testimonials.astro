---
// Quotes are verbatim; `highlight` must be an exact substring of `body`.
const testimonials = [
  {
    body: "Oniel is a brilliant software developer who really understands how to build both people and products. His biggest strength is his ability to understand and analyze requirements and how he can connect with the rest of the team members. Even on the most difficult task, Oniel proved to be able to truly understand them and prioritize them correctly.",
    highlight: "really understands how to build both people and products",
    name: "Stacey Díaz",
    role: "Software Project Manager",
  },
  {
    body: "Oniel has extensive experience in both web and AR/VR technologies that make him a very competent developer. In general, he is a great software engineer with a great deal of knowledge in front-end and back-end development. He is constantly learning and does not stop when faced with a problem, he is conscious and persevering. It's always fun and very productive to work with.",
    highlight: "a great deal of knowledge in front-end and back-end development",
    name: "Leobardo Núñez",
    role: "Software Engineer",
  },
  {
    body: "As a student at Cincinnatus, Oniel made a lasting impression due to his technical abilities, his enthusiasm for learning and being better, and his earnest desire to help other members of our community be better as well. When he wasn't making strides towards completing the program (to which he was also very committed), he would routinely be found helping others along. Even after graduating, we have continued to rely on him for support, and I have always appreciated his eagerness to continue mentoring those students who have come after him.",
    highlight: "his earnest desire to help other members of our community be better as well",
    name: "María Cruz Minaya",
    role: "Community Team Member, Cincinnatus",
  },
].map((t) => {
  const [before, after] = t.body.split(t.highlight);
  const initials = t.name
    .split(" ")
    .map((w) => w[0])
    .join("");
  return { ...t, before, after, initials };
});
---

<section class="section testimonials" id="testimonials" aria-labelledby="t-title">
  <div class="container">
    <header class="section-head">
      <span class="eyebrow">Kind words</span>
      <h2 class="section-title" id="t-title" data-reveal="clip">
        From people I've <span class="serif">built</span> with.
      </h2>
    </header>

    <div class="quotes" role="region" aria-label="Testimonials" tabindex="0">
      {
        testimonials.map((t, i) => (
          <figure class="quote" data-reveal="up" style={`--i:${i}`}>
            <svg class="quote-mark" width="22" height="16" viewBox="0 0 22 16" aria-hidden="true">
              <path d="M0 16V9.6C0 3.9 3 .7 8.2 0l.8 2.2C6.2 3 4.8 4.9 4.6 7.6H9V16H0Zm13 0V9.6C13 3.9 16 .7 21.2 0l.8 2.2c-2.8.8-4.2 2.7-4.4 5.4H22V16h-9Z" />
            </svg>
            <blockquote>
              <p>
                {t.before}
                <mark>{t.highlight}</mark>
                {t.after}
              </p>
            </blockquote>
            <figcaption>
              <span class="initials" aria-hidden="true">
                {t.initials}
              </span>
              <span>
                <span class="name">{t.name}</span>
                <span class="role">{t.role}</span>
              </span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--border);
  }

  .quote {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
    padding: var(--space-6) var(--space-6) var(--space-6) 0;
  }

  .quote + .quote {
    padding-left: var(--space-6);
    border-left: 1px solid var(--border);
  }

  .quote-mark {
    fill: var(--accent);
    opacity: 0.9;
  }

  blockquote p {
    color: var(--text-3);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  mark {
    color: var(--text);
    background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0% 1px no-repeat;
    transition: background-size 900ms var(--ease-in-out) 300ms;
  }

  /* The underline draws once the quote has revealed */
  .quote.is-in mark,
  :global(html:not(.js)) mark {
    background-size: 100% 1px;
  }

  @media (prefers-reduced-motion: reduce) {
    mark {
      background-size: 100% 1px;
    }
  }

  figcaption {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: auto;
  }

  .initials {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--border-strong);
    background: var(--surface);
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--text-2);
    flex: none;
  }

  .name,
  .role {
    display: block;
    line-height: 1.35;
  }

  .name {
    font-weight: 500;
    font-size: 0.9375rem;
  }

  .role {
    color: var(--text-3);
    font-size: var(--step--1);
  }

  .quotes:focus-visible {
    outline-offset: 6px;
  }

  /* Tablet & mobile: horizontal scroll-snap with a visible peek */
  @media (max-width: 899px) {
    .quotes {
      display: flex;
      align-items: flex-start;
      gap: var(--space-4);
      margin-inline: calc(var(--gutter) * -1);
      padding: 0 var(--gutter) var(--space-3);
      border-top: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .quotes::-webkit-scrollbar {
      display: none;
    }

    .quote,
    .quote + .quote {
      flex: 0 0 min(84%, 26rem);
      scroll-snap-align: start;
      padding: var(--space-5);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      background: var(--bg-elevated);
    }
  }
</style>
