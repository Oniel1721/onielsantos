---
import Layout from "../layouts/Layout.astro";
import Icon from "../components/Icon.astro";
---

<Layout title="Page not found — Oniel Santos" description="This page doesn't exist.">
  <main id="main" class="not-found container">
    <p class="code">404 · route not found</p>
    <h1>This page took a <span class="serif">wrong turn.</span></h1>
    <p class="lead">The link may be broken, or the page may have moved.</p>
    <a class="btn btn-primary" href="/">
      Back to home
      <Icon name="arrow-right" />
    </a>
  </main>
</Layout>

<style>
  .not-found {
    min-height: 100dvh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--space-5);
  }

  .code {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent-ink);
  }

  h1 {
    font-size: var(--step-4);
    line-height: 1;
    letter-spacing: -0.045em;
    max-width: 12em;
  }

  .lead {
    color: var(--text-2);
    font-size: var(--step-1);
  }
</style>
